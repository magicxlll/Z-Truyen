# Z-Truyen Backend Environment Configuration

# Server Port
PORT=8080

# Custom Storage Directory (Default is ./data)
ZTRUYEN_DATA_DIR=./data

# Scraper Settings
FAST_SCRAPE_CONCURRENCY=5
ENABLE_PLAYWRIGHT_FALLBACK=true

# Optional VIP Credentials for AkayTruyen
AKAY_USERNAME=
AKAY_PASSWORD=

# Optional Cloudflare Tunnel Token for remote access
CLOUDFLARE_TUNNEL_TOKEN=
